# iHub — Information Hub
# Copy this file to .env and fill in values from your own services.
# Never commit .env or put private keys in VITE_* variables.

# Supabase: Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public/publishable browser equivalents (safe to expose in client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Postgres connection string; only needed for Drizzle migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required to authorize protected ingestion endpoints
INGEST_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
# Optional webhook signing secret, if your configured source uses it
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE

# Server-only Firebase service account JSON for FCM HTTP v1 notification sends.
# Store the full service-account JSON as one line in the hosting environment.
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI provider: OpenRouter is preferred when configured; OpenAI remains a fallback.
# OpenRouter free-model router selects an available free model (rate limits/provider availability apply).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Optional OpenAI fallback; used only when OPENROUTER_API_KEY is not configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional evidence-based AI extraction; leave both provider keys blank to disable.
INGEST_AI_ENABLED=1
INGEST_AI_MAX=5

# Optional Apify integration; only needed for configured Apify sources
APIFY_API_KEY=

# Optional JSON-array source configurations; [] means none configured
INGEST_FEEDS=[]
COLLEGE_FEEDS=[]
CAREER_FEEDS=[]
REST_SOURCES=[]
WEBMCP_TOOLS=[]
